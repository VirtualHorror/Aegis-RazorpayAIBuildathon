{
  "name": "@aegis/api",
  "version": "0.1.0",
  "private": true,
  "description": "Aegis API: webhook ingress, orchestrator, action modules, x402 gateway, NL query",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test --max-warnings 0",
    "db:migrate": "tsx src/db/migrate-cli.ts up",
    "db:migrate:down": "tsx src/db/migrate-cli.ts down",
    "db:status": "tsx src/db/migrate-cli.ts status",
    "db:seed": "tsx ../../db/seed/seed.ts"
  },
  "dependencies": {
    "@aegis/shared": "workspace:*",
    "@fastify/cors": "~11.3.0",
    "@fastify/rate-limit": "~11.2.0",
    "dotenv": "~17.4.2",
    "fastify": "~5.12.3",
    "pg": "~8.23.0",
    "zod": "~4.5.4"
  },
  "devDependencies": {
    "@types/node": "~24.9.2",
    "@types/pg": "~8.23.1",
    "pino-pretty": "~13.1.3",
    "tsx": "~4.23.13",
    "typescript": "~5.9.3",
    "vitest": "~5.0.0"
  }
}
