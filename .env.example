# ---- Aegis environment (copy to .env; .env is gitignored) ----------------------
NODE_ENV=development
LOG_LEVEL=info

# API (Fastify) and dashboard (Next.js)
API_PORT=4000
API_HOST=0.0.0.0
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# PostgreSQL 16 (local). Roles/DBs are created by scripts/bootstrap-system.sh.
DATABASE_URL=postgres://aegis:aegis_dev_password@localhost:5432/aegis
DATABASE_URL_READONLY=postgres://aegis_readonly:aegis_readonly_password@localhost:5432/aegis
DATABASE_URL_TEST=postgres://aegis:aegis_dev_password@localhost:5432/aegis_test
AEGIS_ALLOW_PENDING_MIGRATIONS=false

# Razorpay webhook signing secret (HMAC-SHA256 over the raw body). Any 16+ char string works locally.
RAZORPAY_WEBHOOK_SECRET=whsec_local_dev_change_me_please

# LLM provider: auto | anthropic | openai | stub   (auto = anthropic if key, else openai if key, else stub)
AEGIS_LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_MODEL_FAST=claude-opus-5
OPENAI_API_KEY=
OPENAI_API_BASE=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-5.6
OPENAI_MODEL_FAST=gpt-5.4-mini
LLM_TIMEOUT_MS=20000

# Worker
AEGIS_WORKER_ENABLED=true
AEGIS_COMPLIANCE_CRON=false
AEGIS_MODULES_DISABLED=
WORKER_CONCURRENCY=4
WORKER_POLL_MS=500

# x402 simulated facilitator
X402_SIM_SECRET=x402_local_dev_secret_change_me
X402_PAY_TO=merchant:aegis-demo

# Frontend flourishes: auto | 2d | gpu
NEXT_PUBLIC_PRISM_MODE=auto
